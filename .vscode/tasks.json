{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Compilar Sniffer Npcap",
            "command": "gcc",
            "args": [
                "-g",
                "${file}",
                "-I${workspaceFolder}/Npcap-SDK/Include",
                "-L${workspaceFolder}/Npcap-SDK/Lib/x64", 
                "-lwpcap",
                "-lPacket",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
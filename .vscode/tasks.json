{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Compilar Sniffer Npcap",
            "command": "g++",
            "args": [
                "-g",
                "main.cpp",
                "capture.cpp",
                "utils.cpp",
                "Dispositivos.cpp",
                "imgui/imgui.cpp",
                "imgui/imgui_demo.cpp",
                "imgui/imgui_draw.cpp",
                "imgui/imgui_tables.cpp",
                "imgui/imgui_widgets.cpp",
                "imgui/backends/imgui_impl_win32.cpp",
                "imgui/backends/imgui_impl_dx11.cpp",
                "-I${workspaceFolder}/imgui",
                "-I${workspaceFolder}/imgui/backends",
                "-I${workspaceFolder}/Npcap-SDK/Include",
                "-L${workspaceFolder}/Npcap-SDK/Lib/x64", 
                "-lwpcap",
                "-lPacket",
                "-lws2_32",
                "-lgdi32",
                "-lcomctl32",
                "-ld3d11",
                "-ld3dcompiler",
                "-ldxgi",
                "-ldwmapi",
                "-mwindows",
                "-o",
                "${workspaceFolder}\\Sniffer.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}